# ── Epifani Portal ──────────────────────────────────────────────
EPIFANI_API_URL=http://localhost:3000/api/predictions

# ── Google Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs (journey video voiceover — emotional, consistent voice) ──
# Get a key at https://elevenlabs.io (free tier ~10k chars/mo).
# Leave blank to fall back to free Edge-TTS.
ELEVENLABS_API_KEY=
# Voice id (default = Adam). Browse voices in the ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Speech tempo 0.7-1.2 (eleven_v3 ignores it; use eleven_multilingual_v2 or turbo)
VOICE_SPEED=1.15

# ── Twitter / X API v2 ──────────────────────────────────────────
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here

# ── Instagram API (Meta Graph API) ──────────────────────────────
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
# Long-lived token (60 days). The journey daemon refreshes it every night — once it
# lapses you must generate a new one in the Meta developer dashboard.
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_or_page_access_token_here

# ── TikTok Content Posting API ──────────────────────────────────
# Run `python tools/tiktok_auth.py` once — it writes TIKTOK_REFRESH_TOKEN; access tokens
# (24h) are then minted automatically.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.epifanii.com/
TIKTOK_REFRESH_TOKEN=
# inbox = video lands in your TikTok app as a draft (tap Post). direct = public post,
# only allowed after TikTok audits the app.
TIKTOK_POST_MODE=inbox
# Legacy: static token, or 'manual' to skip TikTok
TIKTOK_ACCESS_TOKEN=manual

# Platforms to pause auto-posting on, comma-separated (instagram,tiktok,youtube,x)
SOCIAL_SKIP=

# ── YouTube Data API v3 (Shorts) ─────────────────────────────────
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# ── Telegram Bot Alerts ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_FEEDBACK_CHAT_ID=your_telegram_feedback_chat_id_here

# ── Settings ─────────────────────────────────────────────────────
# Day 1 of the "building Epifani" journey — drives the "Day X" counter
# in the Founder's Journey scripts. Format: YYYY-MM-DD.
# If unset, Day 1 is inferred from the earliest entry in analytics.db.
EPIFANI_START_DATE=2025-12-15
# Minimum confidence to include a pick (0.0–1.0)
# Only post picks where is_value=true
VALUE_BETS_ONLY=true
# UTM source tag appended to CTA links
UTM_SOURCE=twitter
# Default script ending: "site" (link to epifanii.com) or "comment"
# (comment-gate: viewers comment a keyword, you DM them the model's output).
# The dashboard/CLI can override per script.
CTA_MODE=site
# The keyword viewers comment to get the DM (comment-gate CTA)
COMMENT_GATE_WORD=MODEL


# Same value as API_UPDATE_SECRET in Vercel; unlocks the full /api/predictions feed
API_UPDATE_SECRET=
